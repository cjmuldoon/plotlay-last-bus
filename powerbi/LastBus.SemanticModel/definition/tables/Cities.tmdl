	partition Cities = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("cities.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"city", "residents", "no_stop_pct", "bus_after_21_pct", "bus_after_22_pct", "bus_after_23_pct", "sunday_bus_after_21_pct", "any_mode_after_21_pct", "last_bus_9_to_10_pm", "last_bus_9_to_10_pm_pct"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"city", type text}, {"residents", Int64.Type}, {"no_stop_pct", type number}, {"bus_after_21_pct", type number}, {"bus_after_22_pct", type number}, {"bus_after_23_pct", type number}, {"sunday_bus_after_21_pct", type number}, {"any_mode_after_21_pct", type number}, {"last_bus_9_to_10_pm", Int64.Type}, {"last_bus_9_to_10_pm_pct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
