table Cities
	lineageTag: f517e4b0-a3b8-9a01-8f69-ebcf56b974de

	/// Share of the city's residents with a bus still to come within 400 m after 9 pm, weekday
	measure 'Bus after 9 pm' = AVERAGE ( Cities[bus_after_21_pct] )
		formatString: 0.0
		lineageTag: ac8e0615-1a96-13af-1f95-b859caecda88

	/// Melburnians whose latest bus within 400 m leaves between 9 and 10 pm, weekday
	measure 'Melbourne 9 to 10 pm' = CALCULATE ( SUM ( Cities[last_bus_9_to_10_pm] ), Cities[city] = "Melbourne" )
		formatString: #,0
		lineageTag: 05e498ae-29aa-a877-8b27-261a11c511f9

	/// Share of Greater Melbourne's residents with a bus to come after 9 pm
	measure 'Melbourne after 9 pm' = CALCULATE ( AVERAGE ( Cities[bus_after_21_pct] ), Cities[city] = "Melbourne" )
		formatString: 0.0
		lineageTag: c8b89b64-e9cd-d9ac-39b2-e0785246dab5

	/// Share of Greater Melbourne's residents with a bus to come after 10 pm
	measure 'Melbourne after 10 pm' = CALCULATE ( AVERAGE ( Cities[bus_after_22_pct] ), Cities[city] = "Melbourne" )
		formatString: 0.0
		lineageTag: 7bc5aaa6-028a-d70a-ba91-3f8d2903e8ae

	/// Share of Greater Sydney's residents with a bus to come after 11 pm
	measure 'Sydney after 11 pm' = CALCULATE ( AVERAGE ( Cities[bus_after_23_pct] ), Cities[city] = "Sydney" )
		formatString: 0.0
		lineageTag: 35c9a9e8-8208-503b-35a6-690d3a6e254d

