table Suburbs
	lineageTag: 78368984-6814-5f0f-0156-58f4d5dfe55e

	/// Share of the suburb's residents with a bus still to leave a stop within 400 m after 9 pm on the weekday; blank (grey on the map) where the suburb has fewer than 200 residents a km²
	measure 'After 9 pm' = IF ( MIN ( Suburbs[per_km2] ) >= 200, AVERAGE ( Suburbs[wd_bus_after_21_pct] ) )
		formatString: 0.0
		lineageTag: fd53b66a-cdc6-6f69-fdd0-40c094fc0559

	/// Residents (ABS Census 2021)
	measure 'Suburb residents' = SUM ( Suburbs[residents] )
		formatString: #,0
		lineageTag: 0295442b-34e0-3280-1ca4-35b5eabd6636

