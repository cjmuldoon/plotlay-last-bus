	partition Suburbs = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("suburbs.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"city", "sal_code", "suburb", "residents", "per_km2", "stop_400m_pct", "wd_bus_after_19_pct", "wd_bus_after_20_pct", "wd_bus_after_21_pct", "wd_bus_after_22_pct", "wd_bus_after_23_pct", "wd_bus_after_24_pct", "su_bus_after_21_pct", "su_bus_after_22_pct", "su_bus_after_23_pct", "wd_quiet", "su_quiet"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"city", type text}, {"sal_code", type text}, {"suburb", type text}, {"residents", Int64.Type}, {"per_km2", type number}, {"stop_400m_pct", type number}, {"wd_bus_after_19_pct", type number}, {"wd_bus_after_20_pct", type number}, {"wd_bus_after_21_pct", type number}, {"wd_bus_after_22_pct", type number}, {"wd_bus_after_23_pct", type number}, {"wd_bus_after_24_pct", type number}, {"su_bus_after_21_pct", type number}, {"su_bus_after_22_pct", type number}, {"su_bus_after_23_pct", type number}, {"wd_quiet", type text}, {"su_quiet", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
